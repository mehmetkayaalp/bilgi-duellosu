{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "$code.matches(/^[0-9]{6}$/)",
        "names": {
          "p0": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "p1": { ".validate": "newData.isString() && newData.val().length <= 20" }
        },
        "scores": {
          "$i": { ".validate": "newData.isNumber()" }
        },
        "$other": { ".validate": true }
      }
    },

    "matchmaking": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null",
        ".validate": "$code.matches(/^[0-9]{6}$/)"
      }
    }
  }
}
