{
  "rules": {
    "rooms": {
      "$code": {
        ".read": true,
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{6}$/)"
      }
    },
    "matchmaking": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "$code.matches(/^[0-9]{6}$/)"
      }
    }
  }
}
